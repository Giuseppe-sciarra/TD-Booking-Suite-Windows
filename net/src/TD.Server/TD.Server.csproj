<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TD.Server</RootNamespace>
    <AssemblyName>TDBookingServer</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../TD.Core/TD.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../suite/wordpress/td-booking-suite/**/*" LogicalName="wp/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Guide/*.json" LogicalName="guide/%(Filename)%(Extension)" /></ItemGroup>
</Project>
