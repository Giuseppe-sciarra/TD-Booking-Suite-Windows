<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TD.Server</RootNamespace>
    <AssemblyName>TDBookingServer</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="52.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../TD.Core/TD.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../suite/wordpress/td-booking-suite/**/*" LogicalName="wp/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Web/privacy-standard.txt" LogicalName="privacy-standard.txt" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Web/passkey.html" LogicalName="tpl/passkey.html" /><EmbeddedResource Include="Web/passkey.js" LogicalName="static/net/passkey.js" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../tdwin/static/**/*" LogicalName="static/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Guide/*.json" LogicalName="guide/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../suite/templates/*.html" LogicalName="tpl/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../suite/static/**/*" LogicalName="static/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
</Project>
