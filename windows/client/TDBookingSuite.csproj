<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programma per le postazioni: una finestra WebView2 sul server di TD Booking Suite -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TDBookingSuite</AssemblyName>
    <RootNamespace>TDBookingSuite</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>TD Booking Suite</Product>
    <Company>Tastiere Digitali</Company>
    <Copyright>Tastiere Digitali</Copyright>
    <Version Condition="'$(Version)' == ''">2.8.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
