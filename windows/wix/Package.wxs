<?xml version="1.0" encoding="utf-8"?>
<!-- MSI di TD Booking Suite: funzione Server (database, programma, backup) e funzione Postazione (la finestra del programma).
     Costruito da windows/build.ps1 con WiX 5:  wix build Package.wxs -bindpath server=... -bindpath postazione=... -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="TD Booking Suite" Manufacturer="Tastiere Digitali" Version="$(var.Version)" UpgradeCode="6F3B2C61-8D7E-4B1A-9C55-3E2A1D9B7F40"
           Scope="perMachine" Language="1040" Codepage="1252" InstallerVersion="500">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="È già installata una versione più recente di TD Booking Suite." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="app.ico" SourceFile="!(bindpath.postazione)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <!-- for a silent install:  msiexec /i TD-Booking-Suite.msi ADDLOCAL=Server,Postazione PORTA=8443 INDIRIZZO=https://ufficio-pc:8443 /qn -->
    <Property Id="PORTA" Value="8443" Secure="yes" />
    <Property Id="INDIRIZZO" Secure="yes" />
    <Property Id="ALTRI_INDIRIZZI" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TD Booking Suite">
        <Directory Id="SERVERDIR" Name="server" />
        <Directory Id="POSTAZIONEDIR" Name="postazione" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MENUDIR" Name="TD Booking Suite" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Server" Title="Server" Level="1" AllowAbsent="yes"
             Description="Database, programma e backup. Va su un solo PC, quello che resta acceso: le postazioni si collegano a lui.">
      <Files Directory="SERVERDIR" Include="!(bindpath.server)\**" />
      <ComponentRef Id="ServerMenu" />
    </Feature>
    <Feature Id="Postazione" Title="Programma per la postazione" Level="1" AllowAbsent="yes"
             Description="La finestra di TD Booking Suite. Va su ogni PC che usa il programma, anche sul server.">
      <Files Directory="POSTAZIONEDIR" Include="!(bindpath.postazione)\**" />
      <ComponentRef Id="PostazioneMenu" />
    </Feature>

    <Component Id="ServerMenu" Directory="MENUDIR" Guid="0E5F2B8A-3C1D-4F6E-9A7B-2D4C6E8F1A3B">
      <Shortcut Id="RestoreShortcut" Name="Ripristina backup" Description="Rimette i dati di un backup di TD Booking Suite"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe" Icon="app.ico" WorkingDirectory="SERVERDIR"
                Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[SERVERDIR]script\ripristina-backup.ps1&quot;" />
      <Shortcut Id="RecoverShortcut" Name="Recupera amministratore" Description="Nuova password per l'amministratore del programma"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe" Icon="app.ico" WorkingDirectory="SERVERDIR"
                Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[SERVERDIR]script\recupera-admin.ps1&quot;" />
      <RemoveFolder Id="RemoveMenuServer" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\TD Booking Suite" Name="Server" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="PostazioneMenu" Directory="MENUDIR" Guid="7A9C1E3F-5B2D-4E8A-B6C4-1F3E5A7C9D2B">
      <Shortcut Id="AppMenu" Name="TD Booking Suite" Target="[POSTAZIONEDIR]TDBookingSuite.exe" WorkingDirectory="POSTAZIONEDIR" Icon="app.ico" />
      <Shortcut Id="AppConfigure" Name="Cambia server della postazione" Target="[POSTAZIONEDIR]TDBookingSuite.exe" Arguments="--configura" WorkingDirectory="POSTAZIONEDIR" Icon="app.ico" />
      <Shortcut Id="AppDesktop" Directory="DesktopFolder" Name="TD Booking Suite" Target="[POSTAZIONEDIR]TDBookingSuite.exe" WorkingDirectory="POSTAZIONEDIR" Icon="app.ico" />
      <RemoveFolder Id="RemoveMenuPostazione" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\TD Booking Suite" Name="Postazione" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- the server's configuration runs as Windows itself, after the files are in place; removal before they go -->
    <SetProperty Id="SetupServer" Sequence="execute" Before="SetupServer"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[SERVERDIR]script\setup-server.ps1&quot; -Porta &quot;[PORTA]&quot; -Origine &quot;[INDIRIZZO]&quot; -Indirizzi &quot;[ALTRI_INDIRIZZI]&quot;" />
    <CustomAction Id="SetupServer" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="RemoveServer" Sequence="execute" Before="RemoveServer"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[SERVERDIR]script\remove-server.ps1&quot;" />
    <CustomAction Id="RemoveServer" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveServer" Before="RemoveFiles" Condition="(!Server=3) AND (&amp;Server=2)" />
      <Custom Action="SetupServer" Before="InstallFinalize" Condition="&amp;Server=3" />
    </InstallExecuteSequence>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Apri TD Booking Suite" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[POSTAZIONEDIR]TDBookingSuite.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)licenza.rtf" />
    <UI>
      <ui:WixUI Id="WixUI_FeatureTree" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND &amp;Postazione=3" />
    </UI>
  </Package>
</Wix>
